{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameMagNet",
  "version": "1.3.0",
  "identifier": "com.gamemagnet.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GameMagNet 游戏目录管理器",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0c1118"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
